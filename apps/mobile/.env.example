# 모바일 셸이 부를 API 의 기준 URL.
#
# 이 파일은 본보기다. 실제 값은 .env.local 에 적는다 — 그 이름은 gitignore 의 *.local 에
# 걸려 커밋되지 않는다. 이 저장소는 공개라 사내 주소를 여기 적지 않는다.
#
# 비워 두면 로컬 목 서버(http://127.0.0.1:4010)로 간다.

# ① 브라우저에서 개발 백엔드에 붙일 때
#    상대 경로로 두어 vite 프록시를 타게 한다. 그 서버는 CORS 를 주지 않아 직접 부르면
#    preflight 가 404 로 떨어진다.
# VITE_API_BASE_URL=/api

# ② 에뮬레이터·실기에서 개발 백엔드에 붙일 때
#    프록시가 없으므로 절대 주소를 준다. 경로 접두 /api 까지 포함한다.
#    함께 CAP_NATIVE_HTTP=1 로 빌드해야 CORS 를 우회한다.
# VITE_API_BASE_URL=http://<사내-주소>/api

# ③ 에뮬레이터에서 로컬 목 서버에 붙을 때 (emulator-run.sh 가 넣어 준다)
# VITE_API_BASE_URL=http://10.0.2.2:4010

# ④ 배포용 릴리스 APK 를 구울 때
#    IP 와 포트를 여기에 적고 apps/mobile/scripts/release-build.sh 를 돌린다.
#    이 값은 빌드 시점에 APK 안으로 굳는다 - 설치한 뒤에는 바꿀 수 없다.
#    http:// 를 주면 그 호스트 하나에만 평문이 열린다 (설계 결정 20 ①). 그 서버가 CORS 를
#    주지 않으면 CAP_NATIVE_HTTP=1 도 함께 준다.
# VITE_API_BASE_URL=http://<IP>:<PORT>/api
